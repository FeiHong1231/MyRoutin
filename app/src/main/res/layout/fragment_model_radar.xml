<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plan_usage_page_background"
    android:orientation="vertical">

    <!-- 模型功能统一收在模型一级页，后续新增雷达能力仍可沿用这个顶部入口。 -->
    <RadioGroup
        android:id="@+id/rgModelRadarTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_model_radar_tabs"
        android:orientation="horizontal"
        android:padding="3dp">

        <RadioButton
            android:id="@+id/rbModelRadar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_model_radar_tab"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/model_radar_tab_title"
            android:textColor="@color/model_radar_tab_text"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbIntelligenceEfficiency"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_model_radar_tab"
            android:button="@null"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/model_radar_efficiency_tab_title"
            android:textColor="@color/model_radar_tab_text"
            android:textSize="14sp" />
    </RadioGroup>

    <ViewFlipper
        android:id="@+id/pageSwitcher"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:measureAllChildren="false">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/svModelRadar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvUpdatedAt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:text="@string/model_radar_waiting_update"
                            android:textColor="@color/plan_usage_text_secondary"
                            android:textSize="13sp"
                            tools:text="数据更新于 2026-08-08 08:30 北京时间" />

                        <TextView
                            android:id="@+id/btnRefreshRadar"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_plan_usage_card_action"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:text="@string/action_refresh"
                            android:textColor="@color/plan_usage_brand_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRadarStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:singleLine="true"
                        android:textColor="@color/plan_usage_warning"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="刷新失败，继续显示上次数据"
                        tools:visibility="visible" />

                    <ProgressBar
                        android:id="@+id/pbRadarLoading"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:indeterminateTint="@color/plan_usage_brand_primary"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvRadarEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/model_radar_empty"
                        android:textColor="@color/plan_usage_text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tvRecommendationTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:singleLine="true"
                        android:text="@string/model_radar_recommendation_title"
                        android:textColor="@color/plan_usage_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecommendations"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        android:overScrollMode="never"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_model_radar_recommendation"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvModelOverviewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:singleLine="true"
                        android:text="@string/model_radar_model_overview_title"
                        android:textColor="@color/plan_usage_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvModelOverviewHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:text="@string/model_radar_model_overview_hint"
                        android:textColor="@color/plan_usage_text_tertiary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRadarModels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_model_radar_model"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvRadarSource"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/plan_usage_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/model_radar_source"
                    android:textColor="@color/plan_usage_brand_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/svIntelligenceEfficiency"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvEfficiencyUpdatedAt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:text="@string/model_radar_waiting_update"
                            android:textColor="@color/plan_usage_text_secondary"
                            android:textSize="13sp"
                            tools:text="数据更新于 2026-08-08 08:30 北京时间" />

                        <TextView
                            android:id="@+id/btnRefreshEfficiency"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_plan_usage_card_action"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:text="@string/action_refresh"
                            android:textColor="@color/plan_usage_brand_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEfficiencyStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:singleLine="true"
                        android:textColor="@color/plan_usage_warning"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="刷新失败，继续显示上次数据"
                        tools:visibility="visible" />

                    <ProgressBar
                        android:id="@+id/pbEfficiencyLoading"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:indeterminateTint="@color/plan_usage_brand_primary"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvEfficiencyEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/model_radar_efficiency_empty"
                        android:textColor="@color/plan_usage_text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvEfficiencyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:singleLine="true"
                        android:text="@string/model_radar_efficiency_title"
                        android:textColor="@color/plan_usage_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvEfficiencyMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:textColor="@color/plan_usage_text_tertiary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="近24小时 532 次有效作答 · 每个档位独立统计"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/llEfficiencyFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="38dp"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text="@string/model_radar_efficiency_model_filter"
                                android:textColor="@color/plan_usage_text_secondary"
                                android:textSize="12sp" />

                            <HorizontalScrollView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:overScrollMode="never"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:id="@+id/llEfficiencyModelFilters"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal" />
                            </HorizontalScrollView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="38dp"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text="@string/model_radar_efficiency_effort_filter"
                                android:textColor="@color/plan_usage_text_secondary"
                                android:textSize="12sp" />

                            <HorizontalScrollView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:overScrollMode="never"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:id="@+id/llEfficiencyEffortFilters"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal" />
                            </HorizontalScrollView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEfficiency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_model_radar_efficiency"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvEfficiencySource"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/plan_usage_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/model_radar_source"
                    android:textColor="@color/plan_usage_brand_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</LinearLayout>
