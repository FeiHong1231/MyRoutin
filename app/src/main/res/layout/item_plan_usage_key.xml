<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_plan_usage_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:id="@+id/llKeyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvKeyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="170dp"
                    android:singleLine="true"
                    android:textColor="@color/plan_usage_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="主力 Key" />

                <TextView
                    android:id="@+id/tvKeyRefreshing"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"
                    android:text="正在刷新..."
                    android:textColor="@color/plan_usage_brand_primary"
                    android:textSize="12sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMaskedKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/plan_usage_text_tertiary"
                android:textSize="12sp"
                tools:text="plan-1234****abcdef" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvToggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_plan_usage_card_action"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/plan_usage_brand_primary"
                android:textSize="13sp"
                tools:text="展开" />

            <TextView
                android:id="@+id/tvManage"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_plan_usage_card_action"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="管理"
                android:textColor="@color/plan_usage_brand_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/plan_usage_warning"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="订阅已过期，当前展示最后有效数据"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvCollapsedHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="已收起，点击卡片标题展开详情"
        android:textColor="@color/plan_usage_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/llKeyDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEmptyUsageHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/plan_usage_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llPrimaryDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llDetailRowFirst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailLabelFirst"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/plan_usage_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetailValueFirst"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/plan_usage_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDetailRowSecond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailLabelSecond"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/plan_usage_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetailValueSecond"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/plan_usage_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDetailRowThird"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailLabelThird"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/plan_usage_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetailValueThird"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/plan_usage_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDetailRowFourth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailLabelFourth"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/plan_usage_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetailValueFourth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/plan_usage_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvCycleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="周期订阅"
            android:textColor="@color/plan_usage_brand_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llDayQuota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDayQuotaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/plan_usage_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDayQuotaDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDayQuotaPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbDayQuotaProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:indeterminate="false"
                android:max="1000" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llWeekQuota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWeekQuotaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/plan_usage_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWeekQuotaDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWeekQuotaPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbWeekQuotaProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:indeterminate="false"
                android:max="1000" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llCycleWindowEndFirst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCycleWindowEndLabelFirst"
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:textColor="@color/plan_usage_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCycleWindowEndValueFirst"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/plan_usage_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llCycleWindowEndSecond"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCycleWindowEndLabelSecond"
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:textColor="@color/plan_usage_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCycleWindowEndValueSecond"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/plan_usage_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResourceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="资源包套餐"
            android:textColor="@color/plan_usage_brand_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llTokenQuota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTokenQuotaDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTokenQuotaPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbTokenQuotaProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:indeterminate="false"
                android:max="1000" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNoQuotaHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="暂无可展示额度"
            android:textColor="@color/plan_usage_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llAllowedModelsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAllowedModelsLabel"
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:textColor="@color/plan_usage_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAllowedModelsValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/plan_usage_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llGroupMultipliersRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGroupMultipliersLabel"
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:textColor="@color/plan_usage_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvGroupMultipliersValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/plan_usage_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLastUpdatedRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLastUpdatedLabel"
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:textColor="@color/plan_usage_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLastUpdatedValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/plan_usage_text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
