<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="216dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_plan_usage_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvRecommendationScene"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/plan_usage_text_secondary"
        android:textSize="12sp"
        tools:text="日常开发" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRecommendationModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/plan_usage_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="5.6-terra" />

        <TextView
            android:id="@+id/tvRecommendationEffort"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_plan_usage_card_action"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/plan_usage_brand_primary"
            android:textSize="11sp"
            tools:text="high 高" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRecommendationIq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/plan_usage_brand_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="IQ 112.5" />

        <TextView
            android:id="@+id/tvRecommendationMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:singleLine="true"
            android:textColor="@color/plan_usage_text_tertiary"
            android:textSize="11sp"
            tools:text="$0.32 · 4.8 分钟" />
    </LinearLayout>
</LinearLayout>
