<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 云备份不应包含只能由原设备 Keystore 解密的 Key 缓存。 -->
        <exclude domain="sharedpref" path="plan_usage_input_cache.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- 设备迁移同样排除 Key，避免迁移后留下无法解密的密文。 -->
        <exclude domain="sharedpref" path="plan_usage_input_cache.xml" />
    </device-transfer>
</data-extraction-rules>
