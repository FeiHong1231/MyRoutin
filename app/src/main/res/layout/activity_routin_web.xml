<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plan_usage_page_background">

    <WebView
        android:id="@+id/webRoutin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/routin_web_content" />

    <ProgressBar
        android:id="@+id/progressRoutin"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/routin_web_loading" />
</FrameLayout>
