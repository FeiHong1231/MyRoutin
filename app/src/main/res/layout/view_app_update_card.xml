<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_plan_usage_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp"
    android:visibility="gone"
    tools:visibility="visible">

    <FrameLayout
        android:id="@+id/flUpdateProgress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.hss.myroutin.widget.UpdateCircleProgressView
            android:id="@+id/ucpUpdateProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnToggleUpdateDownload"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/update_pause_download"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_update_float_pause"
            app:tint="@color/plan_usage_text_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvUpdateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/plan_usage_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="新版本 v3.1 正在下载" />

        <TextView
            android:id="@+id/tvUpdateDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textColor="@color/plan_usage_text_secondary"
            android:textSize="12sp"
            tools:text="8.4 MB / 12.4 MB" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnUpdateAction"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_plan_usage_card_action"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/plan_usage_brand_primary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="立即安装"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnDismissUpdate"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/update_close_prompt"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_update_float_close"
        app:tint="@color/plan_usage_text_primary" />
</LinearLayout>
